{
  "components": {
    "schemas": {
      "Held": {
        "properties": {
          "more": {
            "type": "boolean"
          },
          "secrets": {
            "items": {
              "$ref": "#/components/schemas/Secret"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Party": {
        "properties": {
          "kind": {
            "type": "string"
          },
          "org": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Ready": {
        "properties": {
          "name": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Seal": {
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "blob": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "bytes": {
            "format": "int64",
            "type": "integer"
          },
          "counts": {
            "items": {
              "format": "int32",
              "type": "integer"
            },
            "type": "array"
          },
          "free": {
            "type": "object"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "nested": {
            "$ref": "#/components/schemas/Party"
          },
          "owner": {
            "$ref": "#/components/schemas/Party"
          },
          "rotate": {
            "type": "boolean"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "weight": {
            "format": "double",
            "type": "number"
          }
        },
        "type": "object"
      },
      "Sealed": {
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Secret": {
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/Party"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "title": "vault",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "vault_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "ok"
          }
        },
        "summary": "Report whether this replica is serving"
      }
    },
    "/v1/seal": {
      "post": {
        "operationId": "vault_seal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Seal"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sealed"
                }
              }
            },
            "description": "ok"
          }
        },
        "summary": "Seal a secret. The value is never readable again."
      }
    },
    "/v1/secrets": {
      "get": {
        "operationId": "vault_list",
        "parameters": [
          {
            "in": "query",
            "name": "org",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Held"
                }
              }
            },
            "description": "ok"
          }
        },
        "summary": "List the secrets this vault holds"
      }
    },
    "/v1/secrets/{name}": {
      "get": {
        "operationId": "vault_read",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "reveal",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Secret"
                }
              }
            },
            "description": "ok"
          }
        },
        "summary": "Read one secret's record by name"
      }
    }
  }
}
